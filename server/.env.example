PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/spaceshare
JWT_SECRET=change_this_to_any_long_random_text
CLIENT_URL=http://localhost:5173

# From cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Support chatbot: free key from console.groq.com, API Keys
GROQ_API_KEY=
# Optional. Default is openai/gpt-oss-20b (fastest). For smarter but slower answers use openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-20b

# Google sign-in: Client ID from console.cloud.google.com (see README)
GOOGLE_CLIENT_ID=

# Optional: listings created by this account get a "Demo listing" tag (default below)
# DEMO_EMAIL=spacioapp.support@gmail.com
